{
  "manifest_version": 3,
  "name": "NUScope Floating Assistant",
  "version": "0.3.0",
  "description": "Capture research excerpts without leaving the page.",
  "permissions": [
    "storage",
    "sidePanel",
    "activeTab",
    "permissions",
    "tabs"
  ],
  "host_permissions": [
    "https://*.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open NUScope Assistant"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "optional_host_permissions": [
    "https://*/*"
  ]
}
